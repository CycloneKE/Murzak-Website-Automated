# /etc/nginx/sites-available/pos-tenants-wildcard
#
# Front door for every customer's own Murzak POS: <tenant>.pos.murzaktech.tech.
#
# A POS purchase on murzaktech.tech provisions a private Frappe site
# <tenant>.erp.murzaktech.tech with techsavanna_pos installed
# (murzak-bench-provision). This block puts the Murzak POS app in front of it:
#
#   /           the POS single-page app — ONE build for every shop, deployed
#               to /var/www/pos-tenant by the Murzak-PoS-Frontend workflow,
#               built with REACT_APP_API_URL=/api/method so it always talks to
#               its own origin.
#   /api/       proxied to the bench, pinned to THIS tenant's site. The tenant
#               is taken from the hostname, so <x>.pos only ever reaches
#               <x>.erp — there is no header or parameter a caller can use to
#               point it at another shop.
#   /files/     that site's public uploads (item images).
#
# So a new shop needs no DNS record, certificate, build or nginx edit: the
# site exists on the bench and this block already serves it. An unprovisioned
# name gets the app shell, and its API calls get Frappe's "site not found".
#
# WHY A SEPARATE FILE: same reason as erp-tenants-wildcard — conf.d/
# frappe-bench.conf is regenerated by `bench setup nginx`.
#
# WHY IT CANNOT DISTURB EXISTING SITES: pos.murzaktech.tech and
# api.pos.murzaktech.tech have exact server_names (conf.d/pos_frontend.conf,
# conf.d/frappe-bench.conf), and nginx always prefers an exact name over a
# wildcard or regex. The bare pos.murzaktech.tech also has no extra label, so
# it never matches here.
#
# Requires: certbot certificate --cert-name pos-wildcard covering
#           *.pos.murzaktech.tech (DNS-01 via certbot-hostinger-dns), the DNS
#           record  *.pos.murzaktech.tech  A  187.124.217.78,
#           conf.d/00-murzak-pos-guard-map.conf and
#           snippets/murzak-pos-guard.conf.

server {
    listen      80;
    listen      [::]:80;
    server_name *.pos.murzaktech.tech;
    return 301 https://$host$request_uri;
}

server {
    listen      443 ssl http2;
    listen      [::]:443 ssl http2;
    # One label only, and only what murzak-bench-provision can produce as a
    # slug, so the captured name is always a valid site directory name.
    # Quoted: an unquoted regex containing {} is a config syntax error.
    server_name "~^(?<murzak_pos_tenant>[a-z0-9][a-z0-9-]{0,39})\.pos\.murzaktech\.tech$";

    ssl_certificate     /etc/letsencrypt/live/pos-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pos-wildcard/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    set $murzak_pos_site "${murzak_pos_tenant}.erp.murzaktech.tech";

    # Refuse guest access to the POS API before anything is proxied.
    include snippets/murzak-pos-guard.conf;

    root /var/www/pos-tenant;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 50m;

    proxy_buffer_size       128k;
    proxy_buffers           4 256k;
    proxy_busy_buffers_size 256k;

    # Caching is set with `expires`, not add_header: any add_header inside a
    # location silently drops the server-level security headers above.

    # Hashed build assets never change under the same name.
    location /static/ {
        try_files $uri =404;
        expires 1y;
    }

    # The app shell must never be cached, or a shop keeps running an old
    # bundle (with old hashed asset names that --delete has removed) after a
    # deploy.
    location / {
        try_files $uri /index.html;
        expires -1;
    }

    location ^~ /api/ {
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Frappe-Site-Name $murzak_pos_site;
        proxy_set_header Host $murzak_pos_site;
        proxy_set_header X-Use-X-Accel-Redirect True;
        proxy_read_timeout 120;
        proxy_redirect off;
        proxy_pass http://127.0.0.1:8000;
    }

    # Public uploads of THIS shop's site only.
    location ^~ /files/ {
        root /home/murzakerp/frappe-bench/sites/$murzak_pos_site/public;
        try_files $uri =404;
        # Uploaded HTML/SVG/XML is a download, never rendered under this
        # origin — the same rule erp-tenants-wildcard applies.
        location ~* \.(htm|html|svg|xml)$ {
            add_header Content-Disposition "attachment";
            add_header X-Content-Type-Options nosniff;
        }
    }

    # Private files: Frappe permission-checks /private/files/... (reached via
    # /api/method/... or the proxied path below) and hands the read back here.
    location ^~ /private/files/ {
        proxy_set_header X-Frappe-Site-Name $murzak_pos_site;
        proxy_set_header Host $murzak_pos_site;
        proxy_set_header X-Use-X-Accel-Redirect True;
        proxy_pass http://127.0.0.1:8000;
    }
    location ~ ^/protected/(.*) {
        internal;
        root /home/murzakerp/frappe-bench/sites;
        try_files /$murzak_pos_site/$1 =404;
    }
}
