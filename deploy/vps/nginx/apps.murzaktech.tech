# /etc/nginx/sites-available/apps.murzaktech.tech
#
# Wildcard vhost for Coolify-provisioned customer apps.
#
#   :80  ACME webroot + proxy to Traefik (7080)
#   :443 catch-all for hosts that are not published yet
#
# Per-host :443 vhosts (sites-available/app-<fqdn>, generated by
# murzak-app-vhost) carry an exact server_name, and nginx prefers an exact
# match over a wildcard, so those always win over the catch-all below.
#
# Safety: server_name *.apps.murzaktech.tech matches no pre-existing vhost, and
# neither block declares default_server, so this cannot capture traffic for any
# other site on this box.
#
# $murzak_apps_connection_upgrade is defined in conf.d/00-murzak-apps-map.conf.

server {
    listen      80;
    listen      [::]:80;
    server_name *.apps.murzaktech.tech;

    # Served locally, never proxied: nginx terminates TLS for these hosts, so
    # nginx is the party that needs the certificate. ^~ so it beats any regex
    # location and is never handed to the proxy below.
    location ^~ /.well-known/acme-challenge/ {
        root         /var/www/certbot;
        default_type "text/plain";
        try_files    $uri =404;
    }

    # Customer apps may accept large uploads; don't cap at nginx's 1m default.
    client_max_body_size 0;

    location / {
        proxy_pass http://127.0.0.1:7080;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $murzak_apps_connection_upgrade;

        # Traefik redirects to https itself; pass that through untouched.
        proxy_redirect off;

        proxy_read_timeout    300s;
        proxy_send_timeout    300s;
        proxy_connect_timeout 30s;
    }
}

# Catch-all for app hostnames with no per-host vhost yet -- i.e. an app that
# murzak-app-sync has not published (or has just torn down).
#
# Without this, such a host falls through to the box's only default_server,
# sites-enabled/mystylecarhire.com, and is answered with a
# CN=mystylecarhire.com certificate. On a white-label platform that leaks one
# customer's domain to anyone probing another's subdomain.
#
# TLS still cannot validate here -- no public CA will sign a name we have not
# proven -- but a self-signed cert bearing our own name fails honestly instead
# of exposing an unrelated tenant.
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    server_name *.apps.murzaktech.tech;

    ssl_certificate     /etc/ssl/murzak/apps-fallback.crt;
    ssl_certificate_key /etc/ssl/murzak/apps-fallback.key;

    # Own log: a busy one here means apps are provisioning but not publishing,
    # i.e. murzak-app-sync is wedged.
    access_log /var/log/nginx/apps-unpublished.log;

    default_type text/plain;
    return 404 "This application is not published yet.\n";
}
