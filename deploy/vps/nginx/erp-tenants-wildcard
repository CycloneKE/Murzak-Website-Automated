# /etc/nginx/sites-available/erp-tenants-wildcard
#
# Front door for every bench-lane tenant: <tenant>.erp.murzaktech.tech.
#
# murzak-bench-provision creates tenant sites under this wildcard, so a new
# customer needs no DNS record, no certificate and no nginx edit -- the site
# exists on the bench and this block already serves it. Same idea as
# apps-wildcard, different upstream: those tenants are Coolify containers behind
# Traefik; these are Frappe sites served by the bench's own gunicorn.
#
# WHY A SEPARATE FILE, NOT /etc/nginx/conf.d/frappe-bench.conf
#   That file is generated by `bench setup nginx` and is overwritten whenever
#   anyone runs it. A wildcard added there would silently vanish, taking every
#   tenant offline at once. Keep this file out of bench's reach.
#
# WHY IT CANNOT DISTURB EXISTING SITES
#   nginx always prefers an exact server_name over a wildcard, so the existing
#   per-site blocks in frappe-bench.conf keep their own certificates. And
#   `erp.murzaktech.tech` itself does NOT match `*.erp.murzaktech.tech` -- a
#   wildcard requires at least one more label -- so the original ERP site is
#   unaffected.
#
# WHY THE HOSTNAME ROUTING WORKS
#   The bench runs with dns_multitenant, so a site's directory IS its hostname.
#   Every path below keys off $host exactly as frappe-bench.conf does. An
#   unknown tenant falls through to Frappe, which answers "site not found" --
#   the correct response for a hostname nobody provisioned.
#
# Upstreams are addressed directly (127.0.0.1:8000 / :9000) rather than by the
# upstream names frappe-bench.conf defines, so this file has no load-order
# dependency on a file it does not control.
#
# Requires: certbot certificate --cert-name erp-wildcard covering
#           *.erp.murzaktech.tech (DNS-01 via certbot-hostinger-dns), and the
#           DNS record  *.erp.murzaktech.tech  A  187.124.217.78.

server {
    listen      80;
    listen      [::]:80;
    server_name *.erp.murzaktech.tech;
    return 301 https://$host$request_uri;
}

server {
    listen      443 ssl http2;
    listen      [::]:443 ssl http2;
    server_name *.erp.murzaktech.tech;

    ssl_certificate     /etc/letsencrypt/live/erp-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/erp-wildcard/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /home/murzakerp/frappe-bench/sites;

    proxy_buffer_size       128k;
    proxy_buffers           4 256k;
    proxy_busy_buffers_size 256k;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload";
    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy "same-origin, strict-origin-when-cross-origin";

    client_max_body_size 50m;

    location /assets {
        try_files $uri =404;
        add_header Cache-Control "max-age=31536000";
    }

    # Private files: Frappe permission-checks the request, then hands the
    # actual read back to nginx via X-Accel-Redirect to this internal path.
    location ~ ^/protected/(.*) {
        internal;
        try_files /$host/$1 =404;
    }

    location /socket.io {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Frappe-Site-Name $host;
        proxy_set_header Origin $scheme://$http_host;
        proxy_set_header Host $host;
        proxy_pass http://127.0.0.1:9000;
    }

    location / {
        rewrite ^(.+)/$ $1 permanent;
        rewrite ^(.+)/index\.html$ $1 permanent;
        rewrite ^(.+)\.html$ $1 permanent;

        # Uploaded HTML/SVG/XML is served as a download, never rendered inline,
        # so a tenant cannot host script under another tenant's origin.
        location ~* ^/files/.*.(htm|html|svg|xml) {
            add_header Content-disposition "attachment";
            try_files /$host/public/$uri @webserver;
        }

        try_files /$host/public/$uri @webserver;
    }

    location @webserver {
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Frappe-Site-Name $host;
        proxy_set_header Host $host;
        proxy_set_header X-Use-X-Accel-Redirect True;
        proxy_read_timeout 120;
        proxy_redirect off;
        proxy_pass http://127.0.0.1:8000;
    }
}
