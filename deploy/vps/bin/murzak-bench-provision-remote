#!/usr/bin/env bash
#
# ============================================================================
#  DO NOT DEPLOY THIS AS WRITTEN. Kept as a record of a rejected design.
# ============================================================================
#
#  It works by putting an SSH private key for a sudo-capable host user INSIDE
#  the Murzak app container -- the internet-facing web application. That turns
#  any remote-code-execution bug in the app into full host compromise: the
#  MariaDB root password, the Hostinger DNS token that can rewrite the whole
#  zone, and every tenant's data, including paying customers.
#
#  This codebase already rejected exactly this. deploy/vps/bin/murzak-app-sync
#  is a host-side reconciler "rather than a provisioning hook" precisely so it
#  needs "no SSH credential handed to the app container". The bench lane
#  should follow the same pattern: a systemd timer on the host that pulls
#  queued bench jobs from the Provisioning Job doctype and runs
#  murzak-bench-provision locally. The container never gets host access.
#
#  It also cannot run as-is: verified 2026-09-13, the app image is Alpine with
#  no ssh client, and deploy/ is not shipped into it.
#
#  murzak-bench-provision itself (the host-side half) is sound, installed, and
#  passed an end-to-end test. Only this bridge is the problem.
# ============================================================================
#
# murzak-bench-provision-remote
#
# The container-side half of the bench lane. BENCH_PROVISION_CMD inside the
# Murzak app container points HERE; this forwards the job to
# murzak-bench-provision on the VPS over SSH.
#
# Why a bridge exists at all: the app runs in a Coolify container and the
# Frappe bench lives on the host at /home/murzakerp/frappe-bench. Nothing in
# the container can run `bench`, so the lane's "SSH wrapper" note in
# lanes/bench.js is load-bearing rather than optional.
#
# Env it needs (beyond the JOB_* the lane already sets):
#   BENCH_SSH_HOST   user@host of the VPS, e.g. provisioner@187.124.217.78
#   BENCH_SSH_KEY    path to the private key inside the container
#   BENCH_DB_ROOT_PASSWORD  forwarded to the far side; never logged
#
# stdout is passed through untouched, because the lane parses its last line.
# Anything this wrapper wants to say goes to stderr.

set -euo pipefail

log() { printf '%s %s\n' "[bridge]" "$*" >&2; }

[ -n "${BENCH_SSH_HOST:-}" ] || { log "REFUSED: BENCH_SSH_HOST unset"; exit 2; }
[ -n "${BENCH_SSH_KEY:-}" ]  || { log "REFUSED: BENCH_SSH_KEY unset"; exit 2; }
[ -r "${BENCH_SSH_KEY}" ]    || { log "REFUSED: cannot read key ${BENCH_SSH_KEY}"; exit 2; }

REMOTE_CMD="${BENCH_REMOTE_CMD:-/usr/local/bin/murzak-bench-provision}"

# ssh does not forward arbitrary environment, and AcceptEnv on the server is
# another thing to keep in sync, so the job is passed as explicit assignments
# on the remote command line. printf %q quotes each value for the remote shell.
#
# BENCH_DB_ROOT_PASSWORD is passed the same way. That does place it in the
# remote process's argv briefly; the alternative is storing it on the box, and
# the far side reads it from the environment rather than echoing it. If that
# tradeoff is unacceptable, put the password in root-owned config on the VPS
# and drop it from this list.
exec ssh -i "$BENCH_SSH_KEY" \
     -o BatchMode=yes \
     -o StrictHostKeyChecking=accept-new \
     -o ConnectTimeout=20 \
     "$BENCH_SSH_HOST" \
     "env \
        JOB_WEB_ACCOUNT=$(printf %q "${JOB_WEB_ACCOUNT:-}") \
        JOB_SERVICE_ID=$(printf %q "${JOB_SERVICE_ID:-}") \
        JOB_SERVICE_NAME=$(printf %q "${JOB_SERVICE_NAME:-}") \
        JOB_INVOICE=$(printf %q "${JOB_INVOICE:-}") \
        JOB_BENCH_APPS=$(printf %q "${JOB_BENCH_APPS:-}") \
        BENCH_DB_ROOT_PASSWORD=$(printf %q "${BENCH_DB_ROOT_PASSWORD:-}") \
        ${REMOTE_CMD}"
