#!/usr/bin/env bash
#
# murzak-bench-provision
#
# Creates one Frappe tenant site for a paid Provisioning Job. This is the
# script BENCH_PROVISION_CMD points at — lane B (backend/services/provisioning/
# lanes/bench.js) execs it with the job in the environment and reads the last
# line of stdout as JSON.
#
# Runs ON THE VPS, as a user that can sudo to the bench owner. The Murzak app
# runs in a Coolify container and cannot reach /home/murzakerp/frappe-bench
# directly, so BENCH_PROVISION_CMD inside the container must point at the SSH
# wrapper (murzak-bench-provision-remote) which calls this. See DEPLOYMENT.
#
# CONTRACT WITH THE LANE
#   in  (env)  JOB_WEB_ACCOUNT   account this tenant belongs to (required)
#              JOB_SERVICE_ID    catalogue id, e.g. biz-erp-light (required)
#              JOB_BENCH_APPS    comma-separated apps, install order (required)
#              JOB_SERVICE_NAME  human label, logging only
#              JOB_INVOICE       invoice ref, logging only
#              JOB_OWNER_EMAIL   Web Account work_email (required when the
#                                apps include murzak_pos)
#              JOB_OWNER_NAME    Web Account holder name (optional)
#              JOB_SITE_SLUG     customer-chosen address (optional); site
#                                becomes <slug>.erp…, POS <slug>.pos…
#   out (stdout, LAST LINE) {"site":"...","url":"...","admin":"..."}
#                           plus deskUrl/product/posUser/posPassword for a POS
#                           shop, where url is https://<slug>.pos.murzaktech.tech
#   log (stderr)            everything else
#
#   Only the JSON goes to stdout. The lane takes the last stdout line, so a
#   stray echo would be parsed as the result — every diagnostic below is >&2.
#
# IDEMPOTENT. The runner retries, and a half-finished retry must converge:
# an existing site is adopted rather than recreated, and apps already present
# are skipped. Re-running for the same account+service is a no-op that still
# prints the same JSON.
#
# Exit codes: 0 ok
#             2 bad input / missing prerequisite — do NOT retry, escalate
#             1 operational failure — retryable
#
# Deliberately NOT here: DNS and TLS. Tenants live under a wildcard
# (*.erp.murzaktech.tech) exactly like *.apps.murzaktech.tech, so a new tenant
# needs no per-site DNS record or certificate. The script VERIFIES the wildcard
# resolves and refuses if it does not, rather than handing back a URL nobody
# can reach.

set -euo pipefail

BENCH_DIR="${BENCH_DIR:-/home/murzakerp/frappe-bench}"
BENCH_USER="${BENCH_USER:-murzakerp}"
SITE_SUFFIX="${BENCH_SITE_SUFFIX:-erp.murzaktech.tech}"

log()  { printf '%s %s\n' "[$(date -u +%H:%M:%S)]" "$*" >&2; }
die()  { log "ERROR: $*"; exit "${2:-1}"; }
# Refusals the runner must not retry: missing config, unknown app, bad input.
# Retrying these burns the attempt budget and ends in the same place.
refuse() { log "REFUSED: $*"; exit 2; }

# ---- 1. inputs -------------------------------------------------------------
[ -n "${JOB_WEB_ACCOUNT:-}" ] || refuse "JOB_WEB_ACCOUNT is empty"
[ -n "${JOB_SERVICE_ID:-}" ]  || refuse "JOB_SERVICE_ID is empty"

# An empty app set means the catalogue never declared benchApps for this
# product. That is true of biz-webapps and biz-db-medium, which reach this lane
# because laneFor() routes every capacityClass "premium" product here even
# though neither is a Frappe product. Escalate instead of building an ERPNext
# site for someone who bought a database.
[ -n "${JOB_BENCH_APPS:-}" ] || refuse \
  "no benchApps declared for ${JOB_SERVICE_ID} — this product is not a Frappe site; route it off the bench lane"

# ---- 2. site name ----------------------------------------------------------
# Frappe site names are hostnames: lowercase, alnum and hyphen, no leading or
# trailing hyphen. Account ids are not guaranteed to be any of that.
if [ -n "${JOB_SITE_SLUG:-}" ]; then
  # Chosen by the customer at checkout and already validated server-side
  # (services/apps/shopAddress.js) — re-checked here because this script
  # builds hostnames and shell command strings from it. Matched with bash's
  # whole-string regex under the C locale: grep matches line by line, so
  # "ok<newline>; evil" would pass it, and locale ranges can admit accents.
  slug="$JOB_SITE_SLUG"
  slug_re='^[a-z0-9]([a-z0-9-]{1,38}[a-z0-9])$'
  ( export LC_ALL=C; [[ "$slug" =~ $slug_re ]] ) \
    || refuse "JOB_SITE_SLUG is not a valid site name (3-40 chars: a-z, 0-9, hyphen; no leading or trailing hyphen)"
else
  slug="$(printf '%s' "$JOB_WEB_ACCOUNT" \
    | tr '[:upper:]' '[:lower:]' \
    | tr '\n' '-' \
    | sed -e 's/[^a-z0-9-]/-/g' -e 's/-\{2,\}/-/g' -e 's/^-//' -e 's/-$//' \
    | cut -c1-40)"
fi
[ -n "$slug" ] || refuse "JOB_WEB_ACCOUNT '${JOB_WEB_ACCOUNT}' has no usable hostname characters"
SITE="${slug}.${SITE_SUFFIX}"
log "account=${JOB_WEB_ACCOUNT} service=${JOB_SERVICE_ID} -> site=${SITE}"

# ---- 3. prerequisites ------------------------------------------------------
[ -d "$BENCH_DIR" ] || refuse "bench directory ${BENCH_DIR} not found"

# bench new-site needs the MariaDB root credential. Socket auth is NOT enabled
# on this box (verified 2026-09-05: `sudo mysql` fails with access denied), so
# the password must be supplied. Refuse loudly rather than let bench sit on an
# interactive prompt until the runner's 10-minute timeout kills it.
[ -n "${BENCH_DB_ROOT_PASSWORD:-}" ] || refuse \
  "BENCH_DB_ROOT_PASSWORD is unset and MariaDB has no socket auth — bench new-site cannot create a database"

# The wildcard must resolve or the tenant gets a URL that goes nowhere.
if command -v getent >/dev/null 2>&1; then
  probe="prov-check.${SITE_SUFFIX}"
  getent ahostsv4 "$probe" >/dev/null 2>&1 || refuse \
    "*.${SITE_SUFFIX} does not resolve (probed ${probe}) — add the wildcard A record before selling bench tenants"
fi

benchctl() { sudo -u "$BENCH_USER" bash -lc "cd '$BENCH_DIR' && $*"; }

# Every requested app must already be on the bench. Adding one is a scheduled
# operation, not something to do mid-provision: `bench get-app` pip-installs
# into the shared virtualenv and the new app is not importable until the
# workers restart, which briefly 500s EVERY existing tenant (observed
# 2026-09-05 installing hrms). So refuse, and let a human schedule it.
IFS=',' read -r -a APPS <<< "$JOB_BENCH_APPS"
for app in "${APPS[@]}"; do
  [ -n "$app" ] || continue
  [ -d "${BENCH_DIR}/apps/${app}" ] || refuse \
    "app '${app}' is not installed on this bench — installing it needs a worker restart that interrupts every tenant; schedule it, then re-run"
done

# ---- 4. create the site (idempotent) ---------------------------------------
ADMIN_PASSWORD=""
if benchctl "ls sites/'$SITE'/site_config.json" >/dev/null 2>&1; then
  # Never adopt another customer's site. The owning account is read from the
  # site's own config (via stdin, so no path or value is spliced into code)
  # and compared as plain strings. A site made before this stamp existed has
  # no key -> empty owner -> adoptable, as before. If the config cannot be
  # read or parsed we cannot prove ownership, so fail closed (retryable).
  #
  # KNOWN LIMIT, accepted on purpose (verified 2026-10-10): an UNSTAMPED site is
  # adoptable by whichever account asks, so a customer-chosen slug that equals a
  # pre-feature site's name would adopt it. That cannot happen today: no
  # *.erp.murzaktech.tech tenant sites predate the stamp, and the names this
  # script derives from account ids ("user-<digits>…") are reserved server-side
  # (backend/services/apps/shopAddress.js), so no customer can pick one. Do not
  # tighten this to "unstamped + custom slug => refuse": a retry after a failed
  # stamp write would then be refused forever.
  if ! owner="$(benchctl "cat sites/'$SITE'/site_config.json" 2>/dev/null \
      | python3 -c 'import json,sys; print(str(json.load(sys.stdin).get("murzak_web_account", "")))')"; then
    die "could not read the owner of existing site ${SITE} (retryable)"
  fi
  if [ -n "$owner" ] && [ "$owner" != "$JOB_WEB_ACCOUNT" ]; then
    refuse "site ${SITE} belongs to another account — never adopting another customer's site"
  fi
  log "site already exists — adopting it, not recreating"
else
  # Generated per tenant; returned in the JSON so the portal can surface it
  # once. Never logged.
  ADMIN_PASSWORD="$(head -c 18 /dev/urandom | base64 | tr -d '/+=' | cut -c1-16)"
  log "creating site"
  # --no-mariadb-socket keeps bench on password auth, matching this box.
  #
  # Both secrets travel on STDIN, never in sudo's environment. sudo logs the
  # full ENV= of every command it runs (--preserve-env included) to the system
  # journal, which is how the MariaDB root password and each tenant's admin
  # password ended up in `journalctl` in plain text on 2026-10-17. It only logs
  # the command string, not stdin. Known limit: bench itself still receives the
  # values as --db-root-password / --admin-password arguments, so they are
  # visible to local users in /proc while bench runs; the CLI offers no other
  # non-interactive way in.
  if ! printf '%s\n%s\n' "$BENCH_DB_ROOT_PASSWORD" "$ADMIN_PASSWORD" | \
       sudo -u "$BENCH_USER" bash -lc \
       "IFS= read -r DBRP; IFS= read -r BENCH_ADMIN_PW; cd '$BENCH_DIR' && bench new-site '$SITE' \
          --db-root-password \"\$DBRP\" \
          --admin-password \"\$BENCH_ADMIN_PW\" \
          --no-mariadb-socket" >&2; then
    die "bench new-site failed for ${SITE} (retryable)"
  fi
fi

# Stamp the owning account on the site (idempotent). The value goes in through
# the environment, not the command string: account ids are free text and must
# not be able to break out of the quotes inside `bash -lc`.
if ! MURZAK_ACCT="$JOB_WEB_ACCOUNT" \
     sudo -u "$BENCH_USER" --preserve-env=MURZAK_ACCT bash -lc \
     "cd '$BENCH_DIR' && bench --site '$SITE' set-config murzak_web_account \"\$MURZAK_ACCT\"" >&2; then
  die "could not record the owning account on ${SITE} (retryable)"
fi

# ---- 4b. per-app site config that must exist BEFORE install ----------------
# hrms's after_install creates a non-standard user type ("Employee Self
# Service"), and Frappe refuses unless user_type_doctype_limit is already in
# the site config:
#   ValidationError: The limit has not set for the user type Employee Self
#   Service in the site config file.
# A fresh site never has that key, so without this every biz-erp-light and
# starter-hrpay sale fails at `install-app hrms`. Found by the end-to-end test
# on 2026-09-13. The value 50 matches erp.murzaktech.tech, where hrms was
# installed by hand with this set and nobody wrote it down.
#
# set-config is idempotent, so a retry re-applying it is harmless.
for app in "${APPS[@]}"; do
  if [ "$app" = "hrms" ]; then
    log "setting user_type_doctype_limit for hrms (required before install)"
    benchctl "bench --site '$SITE' set-config -p user_type_doctype_limit '{\"employee_self_service\": 50}'" >&2 \
      || die "could not set user_type_doctype_limit on ${SITE} (retryable)"
  fi
done

# ---- 5. install apps, in order, skipping any already present ---------------
installed="$(benchctl "bench --site '$SITE' list-apps" 2>/dev/null | awk '{print $1}' || true)"
for app in "${APPS[@]}"; do
  [ -n "$app" ] || continue
  if printf '%s\n' "$installed" | grep -qx "$app"; then
    log "app ${app} already installed — skipping"
    continue
  fi
  log "installing ${app}"
  benchctl "bench --site '$SITE' install-app '$app'" >&2 \
    || die "install-app ${app} failed on ${SITE} (retryable)"
done

# ---- 6. verify before claiming success -------------------------------------
final="$(benchctl "bench --site '$SITE' list-apps" 2>/dev/null | awk '{print $1}' || true)"
for app in "${APPS[@]}"; do
  [ -n "$app" ] || continue
  printf '%s\n' "$final" | grep -qx "$app" \
    || die "post-check: ${app} still missing from ${SITE} after install (retryable)"
done
log "verified apps on ${SITE}: $(printf '%s' "$final" | tr '\n' ' ')"

# ---- 6b. repair a half-finished hrms setup ---------------------------------
# "installed" does not mean "set up". Frappe registers an app as installed
# BEFORE running its after_install hook, so if that hook aborts, the app is
# listed as installed while its setup never completed -- and the skip logic
# in step 5 would then trust it forever, making a retry useless.
#
# This is not hypothetical. hrms's after_install runs nine steps and aborted
# at step 6 (add_non_standard_user_types) on BOTH erp.murzaktech.tech and the
# 2026-09-13 end-to-end test site, because user_type_doctype_limit was unset.
# Steps 6-9 never ran on either: no Employee Self Service user type, no single
# defaults, no default role profiles, no post-install patches. Core payroll
# still worked, which is why nobody noticed; employee self-service did not.
#
# Step 4b now prevents the abort on fresh installs. This repairs sites where
# it already happened. Gated on the ESS user type being ABSENT -- the exact
# fingerprint of an abort at step 6 -- so a healthy site is never re-set-up.
# Only steps 6-9 run; 1-5 completed before any abort and re-running them
# risks duplicates.
if printf '%s\n' "$final" | grep -qx "hrms"; then
  db="$(python3 -c "import json;print(json.load(open('${BENCH_DIR}/sites/${SITE}/site_config.json'))['db_name'])" 2>/dev/null || true)"
  ess="$(mysql -N -e "SELECT COUNT(*) FROM \`${db}\`.\`tabUser Type\` WHERE name='Employee Self Service'" 2>/dev/null || echo "?")"
  if [ "$ess" = "0" ]; then
    log "hrms setup incomplete (no Employee Self Service user type) — running the steps that never executed"
    for fn in add_non_standard_user_types set_single_defaults create_default_role_profiles run_post_install_patches; do
      benchctl "bench --site '$SITE' execute hrms.setup.$fn" >&2 \
        || die "hrms repair step ${fn} failed on ${SITE} (retryable)"
    done
    log "hrms setup repaired"
  elif [ "$ess" = "?" ]; then
    log "WARNING: could not check hrms setup state on ${SITE}; not repairing blind"
  fi
fi

# ---- 6c. Murzak POS: owner account + the shop's own POS address ------------
# A site with murzak_pos is a Murzak POS shop. The customer uses the POS
# app at <slug>.pos.murzaktech.tech (nginx/pos-tenants-wildcard pins that host
# to this site), never the ERPNext desk, so:
#
#   * the customer-facing url becomes the POS address, and the desk moves to
#     deskUrl (staff-only, like admin);
#   * the shop owner's POS login is created HERE, from the Web Account's own
#     email. Public sign-up is closed on tenant front doors — otherwise the
#     first stranger to find the URL would register as System Manager of
#     someone else's shop.
#
# The owner is created through murzak_pos's own register_user, so roles,
# API keys and the OAuth client are exactly what a self-signed-up owner gets.
# Python is run directly (what `bench execute` does internally) so the
# password travels by environment, never argv — same rule as step 4.
#
# Idempotent: an existing owner is left alone and posPassword is empty, since
# the customer may already be using the one they were given (e.g. a CRM bought
# after the POS re-runs this on the same site). This step runs last so a
# failure between creating the user and printing the JSON is near-impossible.
POS_SUFFIX="${BENCH_POS_SUFFIX:-pos.murzaktech.tech}"
POS_HOST=""
POS_USER=""
POS_PASSWORD=""
if printf '%s\n' "$final" | grep -qx "murzak_pos"; then
  [ -n "${JOB_OWNER_EMAIL:-}" ] || refuse \
    "JOB_OWNER_EMAIL is empty — a POS shop needs an owner login, and sign-up is closed on tenant POS hosts"
  if command -v getent >/dev/null 2>&1; then
    getent ahostsv4 "prov-check.${POS_SUFFIX}" >/dev/null 2>&1 || refuse \
      "*.${POS_SUFFIX} does not resolve — add the wildcard A record before selling POS tenants"
  fi
  POS_HOST="${slug}.${POS_SUFFIX}"
  POS_USER="$(printf '%s' "$JOB_OWNER_EMAIL" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"

  # register_user's own strength rules: >=8 chars with upper, lower, digit and
  # a symbol. The fixed suffix guarantees each class whatever base64 yields.
  candidate="$(head -c 18 /dev/urandom | base64 | tr -d '/+=' | cut -c1-14)Aa7!"

  # The owner's password goes in on stdin (read into the environment inside the
  # bench user's shell), not through sudo's environment, so it is not written to
  # the journal. The python program below still arrives on its own heredoc.
  owner_out="$(printf '%s\n' "$candidate" | POS_OWNER_EMAIL="$POS_USER" POS_OWNER_NAME="${JOB_OWNER_NAME:-}" \
    POS_SITE="$SITE" \
    sudo -u "$BENCH_USER" --preserve-env=POS_OWNER_EMAIL,POS_OWNER_NAME,POS_SITE \
    bash -lc "IFS= read -r POS_OWNER_PW; export POS_OWNER_PW; cd '$BENCH_DIR/sites' && ../env/bin/python - <<'PY'
import json, os, frappe
frappe.init(site=os.environ['POS_SITE'], sites_path='.')
frappe.connect()
try:
    email = os.environ['POS_OWNER_EMAIL']
    if frappe.db.exists('User', email):
        print(json.dumps({'state': 'exists'}))
    else:
        parts = (os.environ.get('POS_OWNER_NAME') or '').split()
        first = parts[0] if parts else 'Shop'
        last = ' '.join(parts[1:]) or 'Owner'
        from murzak_pos.api.auth_api import register_user
        r = register_user(email=email, first_name=first, last_name=last,
                          password=os.environ['POS_OWNER_PW'])
        if isinstance(r, dict) and r.get('success') is False:
            raise Exception('register_user refused: %s %s' % (r.get('code'), r.get('message')))
        frappe.db.commit()
        print(json.dumps({'state': 'created'}))
finally:
    frappe.destroy()
PY" 2>&1)" || die "creating the POS owner on ${SITE} failed (retryable): $(printf '%s' "$owner_out" | tail -3 | tr '\n' ' ' | cut -c1-300)"

  case "$(printf '%s\n' "$owner_out" | tail -1)" in
    *'"created"'*) POS_PASSWORD="$candidate"; log "POS owner ${POS_USER} created" ;;
    *'"exists"'*)  log "POS owner ${POS_USER} already exists — leaving their password alone" ;;
    *) die "POS owner step gave no verdict on ${SITE} (retryable): $(printf '%s' "$owner_out" | tail -1 | cut -c1-200)" ;;
  esac
fi

# ---- 7. result -------------------------------------------------------------
# THE only stdout line. admin is empty on an adopted site — we do not know the
# existing password and must not invent one.
#
# url is what the portal shows the customer: the POS address for a POS shop,
# otherwise the site itself. posUser/posPassword are the owner's POS login
# (password only on the run that created it). JSON is built with python so an
# email or password can never break the quoting.
if [ -n "$POS_HOST" ]; then
  SITE="$SITE" POS_HOST="$POS_HOST" ADMIN_PASSWORD="$ADMIN_PASSWORD" \
  POS_USER="$POS_USER" POS_PASSWORD="$POS_PASSWORD" python3 -c '
import json, os
e = os.environ
print(json.dumps({"site": e["SITE"], "url": "https://" + e["POS_HOST"],
                  "deskUrl": "https://" + e["SITE"], "admin": e["ADMIN_PASSWORD"],
                  "product": "pos", "posUser": e["POS_USER"],
                  "posPassword": e["POS_PASSWORD"]}, separators=(",", ":")))'
else
  printf '{"site":"%s","url":"https://%s","admin":"%s"}\n' \
    "$SITE" "$SITE" "$ADMIN_PASSWORD"
fi
