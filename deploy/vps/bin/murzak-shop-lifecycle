#!/usr/bin/env bash
#
# murzak-shop-lifecycle  sweep [--dry-run]
# murzak-shop-lifecycle  off <site>      switch one shop off by hand
# murzak-shop-lifecycle  on  <site>      switch one shop back on by hand
#
# Switches a customer's Murzak POS shop OFF when their subscription lapses, and
# back ON when they pay. Until this existed the website only marked the Web
# Account "Suspended"; the shop itself kept trading for free.
#
# HOW IT DECIDES
#   For every tenant site on this bench that carries the owner stamp
#   murzak-bench-provision writes (site_config murzak_web_account), it reads
#   that Web Account from the website's Frappe and asks one question: is the
#   subscription paid up?
#     OFF  when account_status is Suspended or Cancelled, or when a POS service
#          row (any service whose catalogue benchApps include murzak_pos) is
#          Suspended.
#     ON   otherwise.
#   renewalService.js (grace window over, RENEWAL_SUSPEND_ENABLED=true) and the
#   payment reversal handlers set those statuses; a paid renewal sets them back.
#   This script only follows them, so it needs no new field and no callback.
#
# WHAT "OFF" MEANS
#   site_config maintenance_mode=1 on that shop's site. Frappe then answers every
#   request with "Session Stopped" (HTTP 503); nothing is deleted, and turning it
#   back on restores the shop exactly as it was. The script also writes
#   murzak_lifecycle_off=1 so it only ever undoes a switch-off it made itself:
#   a shop a person put into maintenance by hand (an upgrade, say) is never
#   switched back on by this script.
#
# FAILS SAFE. If the Web Account cannot be read (network, 404, bad key) the shop
# is left exactly as it is. A shop is switched off only on a clear "Suspended" or
# "Cancelled", never on a missing answer. Sites without the owner stamp (the
# company's own sites) are never touched. Only sites ending in the tenant
# suffix are looked at, and only ones with murzak_pos installed.
#
# CONFIG: /etc/murzak/frappe-api.env (same file murzak-bench-runner uses) and
# /etc/murzak/bench-catalog-snapshot.json. Needs: bash, curl, jq, python3, sudo.
#
# Exit codes: 0 done (or nothing to do)   2 bad input   1 something failed
# Diagnostics go to stderr.

set -euo pipefail

FRAPPE_ENV="${MURZAK_FRAPPE_ENV:-/etc/murzak/frappe-api.env}"
SNAPSHOT="${MURZAK_CATALOG_SNAPSHOT:-/etc/murzak/bench-catalog-snapshot.json}"
BENCH_DIR="${BENCH_DIR:-/home/murzakerp/frappe-bench}"
BENCH_USER="${BENCH_USER:-murzakerp}"
SITE_SUFFIX="${BENCH_SITE_SUFFIX:-erp.murzaktech.tech}"
BENCH_BIN="${MURZAK_BENCH_BIN:-bench}"
SITE_RE='^[a-z0-9]([a-z0-9.-]*[a-z0-9])$'

log()    { printf '%s %s\n' "[$(date -u +%H:%M:%S)]" "$*" >&2; }
refuse() { log "REFUSED: $*"; exit 2; }

# Run a command as the bench owner (skipped when we already are that user).
as_bench() {
  if [ "$(id -un)" = "$BENCH_USER" ]; then "$@"; else sudo -u "$BENCH_USER" "$@"; fi
}

check_site() {
  ( export LC_ALL=C; [[ "$1" =~ $SITE_RE ]] ) || refuse "'$1' is not a valid site name"
  case "$1" in *".${SITE_SUFFIX}") ;; *) refuse "'$1' is not a tenant site (*.${SITE_SUFFIX})" ;; esac
  [ -f "${BENCH_DIR}/sites/${1}/site_config.json" ] || refuse "site $1 does not exist on this bench"
}

# site_config.json value (empty if absent). Read straight from the file. As
# root (how the runner calls this) that needs no sudo; going through sudo for
# every key of every shop on every pass would put thousands of lines a day in
# the system journal, so sudo is only the fallback for an unreadable file.
config_get() { # site key
  local f="${BENCH_DIR}/sites/${1}/site_config.json" prog
  prog='import json,sys
c = json.load(open(sys.argv[1]))
v = c.get(sys.argv[2], "")
print("" if v is None else v)'
  if [ -r "$f" ]; then python3 -c "$prog" "$f" "$2"; else as_bench python3 -c "$prog" "$f" "$2"; fi
}

# Switch a site off/on by editing site_config.json (what `bench set-config`
# does); Frappe reads it on every request, so no restart is needed.
switch_site() { # site off|on
  as_bench python3 -c 'import json,os,sys,tempfile
path, mode = sys.argv[1], sys.argv[2]
c = json.load(open(path))
if mode == "off":
    c["maintenance_mode"] = 1
    c["murzak_lifecycle_off"] = 1
else:
    c.pop("maintenance_mode", None)
    c.pop("murzak_lifecycle_off", None)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w") as f:
    json.dump(c, f, indent=1)
os.chmod(tmp, os.stat(path).st_mode)
os.replace(tmp, path)' "${BENCH_DIR}/sites/${1}/site_config.json" "$2"
}

load_frappe() {
  [ -r "$FRAPPE_ENV" ] || { log "cannot read $FRAPPE_ENV"; exit 1; }
  set -a; . "$FRAPPE_ENV"; set +a
  [ -n "${FRAPPE_BASE_URL:-}" ] && [ -n "${FRAPPE_API_KEY:-}" ] && [ -n "${FRAPPE_API_SECRET:-}" ] \
    || { log "$FRAPPE_ENV is missing FRAPPE_BASE_URL / FRAPPE_API_KEY / FRAPPE_API_SECRET"; exit 1; }
  AUTH="token ${FRAPPE_API_KEY}:${FRAPPE_API_SECRET}"
  BASE="${FRAPPE_BASE_URL%/}"
}

# Prints "paid" or "lapsed". Prints nothing (and returns 1) when the account
# could not be read, so the caller leaves the shop alone.
account_verdict() { # web_account
  local doc
  doc="$(curl -sS --max-time 30 -H "Authorization: $AUTH" -H "Accept: application/json" \
    "${BASE}/api/resource/Web%20Account/$(jq -rn --arg n "$1" '$n|@uri')" 2>/dev/null \
    | jq -ce '.data | select(type == "object")' 2>/dev/null)" || return 1
  [ -n "$doc" ] || return 1
  jq -r --argjson pos "$POS_SERVICES" '
    (.account_status // "Active" | ascii_downcase) as $st
    | ([.selected_services[]? | select((.service_id as $s | $pos | index($s)) and .status == "Suspended")] | length) as $sus
    | if ($st == "suspended" or $st == "cancelled" or $sus > 0) then "lapsed" else "paid" end' <<<"$doc"
}

# ids of catalogue services that include the POS app
load_pos_services() {
  [ -r "$SNAPSHOT" ] || { log "cannot read $SNAPSHOT"; exit 1; }
  POS_SERVICES="$(jq -c '[.items | to_entries[] | select((.value.benchApps // []) | index("murzak_pos")) | .key]' "$SNAPSHOT")"
  [ "$POS_SERVICES" != "[]" ] || { log "no POS services found in $SNAPSHOT; refusing to guess"; exit 1; }
}

has_pos_app() { # site
  # apps are listed per site in the database; apps.txt is bench-wide, so ask the site
  as_bench bash -lc "cd '$BENCH_DIR' && '$BENCH_BIN' --site '$1' list-apps" 2>/dev/null | awk '{print $1}' | grep -qx murzak_pos
}

sweep() {
  local dry="${1:-}" site acct verdict off ours changed=0 failed=0
  load_frappe; load_pos_services
  for dir in "${BENCH_DIR}"/sites/*."${SITE_SUFFIX}"; do
    [ -f "$dir/site_config.json" ] || continue
    site="$(basename "$dir")"
    acct="$(config_get "$site" murzak_web_account 2>/dev/null || true)"
    [ -n "$acct" ] || continue                       # not a customer shop
    verdict="$(account_verdict "$acct" || true)"
    if [ -z "$verdict" ]; then
      log "$site: could not read account ${acct}; leaving the shop as it is"; failed=1; continue
    fi
    off="$(config_get "$site" maintenance_mode)"
    ours="$(config_get "$site" murzak_lifecycle_off)"
    if [ "$verdict" = "lapsed" ] && [ -z "$off" -o "$off" = "0" -o "$off" = "False" ]; then
      has_pos_app "$site" || { log "$site: not a POS shop; skipping"; continue; }
      log "$site: subscription lapsed; switching OFF${dry:+ (dry run)}"
      [ -n "$dry" ] || switch_site "$site" off
      changed=$((changed+1))
    elif [ "$verdict" = "paid" ] && [ -n "$ours" ] && [ "$ours" != "0" ]; then
      log "$site: subscription paid; switching ON${dry:+ (dry run)}"
      [ -n "$dry" ] || switch_site "$site" on
      changed=$((changed+1))
    fi
  done
  log "shop lifecycle sweep done: ${changed} change(s)"
  [ "$failed" -eq 0 ] || return 1
}

case "${1:-sweep}" in
  sweep)
    dry=""; [ "${2:-}" = "--dry-run" ] && dry=1
    sweep "$dry" ;;
  off) [ -n "${2:-}" ] || refuse "usage: murzak-shop-lifecycle off <site>"; check_site "$2"; switch_site "$2" off; log "$2 is OFF" ;;
  on)  [ -n "${2:-}" ] || refuse "usage: murzak-shop-lifecycle on <site>";  check_site "$2"; switch_site "$2" on;  log "$2 is ON" ;;
  *) refuse "usage: murzak-shop-lifecycle [sweep [--dry-run] | off <site> | on <site>]" ;;
esac
