[Unit]
Description=Complete premium (ERP/POS/CRM) bench provisioning jobs the app container escalated
Documentation=https://github.com/CycloneKE/murzaktech.com/blob/master/deploy/vps/README.md
After=network-online.target mariadb.service
Wants=network-online.target mariadb.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/murzak-bench-runner

# Needs root: reads /root/.murzak-db-root-password and /etc/murzak/*, and
# murzak-bench-provision itself needs root to sudo into the bench user and
# reach MariaDB. ProtectHome is read-only (not the default "yes"/inaccessible)
# because the DB root password file lives under /root.
User=root
PrivateTmp=true
ProtectHome=read-only
# ProtectHome=read-only applies to every child process too, and a build has to
# create the new site's folder under the bench user's home, so without this
# line `bench new-site` fails instantly with "Read-only file system". Proven on
# the live server 2026-10-17: the write test failed under these settings and
# passed once this path was listed. The bench user's home is the only path that
# needs to be writable; /root stays read-only.
ReadWritePaths=/home/murzakerp
NoNewPrivileges=true
