{
  "doctype": "DocType",
  "name": "Platform Health Check",
  "module": "Custom",
  "custom": 1,
  "naming_rule": "Expression (old style)",
  "autoname": "format:HEALTH-{#####}",
  "title_field": "summary",
  "track_changes": 0,
  "sort_field": "creation",
  "sort_order": "DESC",
  "fields": [
    { "fieldname": "job_type", "fieldtype": "Select", "label": "Job Type", "options": "orphan_check\ncapacity_snapshot\nbackup", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "ok\nattention\nerror", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "summary", "fieldtype": "Data", "label": "Summary", "in_list_view": 1 },
    { "fieldname": "column_break_1", "fieldtype": "Column Break" },
    { "fieldname": "alert_sent", "fieldtype": "Check", "label": "Alert Sent", "default": "0", "in_list_view": 1 },
    { "fieldname": "detail_json", "fieldtype": "Long Text", "label": "Detail (JSON)" }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1 }
  ]
}
