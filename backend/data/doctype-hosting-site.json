{
  "doctype": "DocType",
  "name": "Hosting Site",
  "module": "Custom",
  "custom": 1,
  "naming_rule": "Expression (old style)",
  "autoname": "hash",
  "title_field": "primary_host",
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    { "fieldname": "web_account", "fieldtype": "Link", "label": "Web Account", "options": "Web Account", "in_list_view": 1, "in_standard_filter": 1, "reqd": 1 },
    { "fieldname": "service_id", "fieldtype": "Data", "label": "Service ID", "in_standard_filter": 1 },
    { "fieldname": "site_type", "fieldtype": "Select", "label": "Site Type", "options": "domain\nmurzak_subdomain\nexternal_domain", "in_list_view": 1 },
    { "fieldname": "primary_host", "fieldtype": "Data", "label": "Primary Host", "in_list_view": 1, "description": "Denormalized copy of the attached domain's name, kept so existing reads and provisioning keep working. customer_domain is the authority — prefer it." },
    { "fieldname": "customer_domain", "fieldtype": "Link", "label": "Customer Domain", "options": "Customer Domain", "in_standard_filter": 1, "description": "The domain record this site serves. Added when domains became account-owned; before this the site only had primary_host as a loose string, so nothing connected a site to the domain it was for." },
    { "fieldname": "column_break_1", "fieldtype": "Column Break" },
    { "fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "pending\nactive\nsuspended", "default": "pending", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "plan_name", "fieldtype": "Data", "label": "Plan Name" },
    { "fieldname": "tier", "fieldtype": "Data", "label": "Tier" },
    { "fieldname": "ssl_status", "fieldtype": "Select", "label": "SSL Status", "options": "none\npending\nactive", "default": "pending" },
    { "fieldname": "document_root", "fieldtype": "Data", "label": "Document Root" },

    { "fieldname": "section_storage", "fieldtype": "Section Break", "label": "Storage" },
    { "fieldname": "storage_limit_mb", "fieldtype": "Int", "label": "Storage Limit (MB)", "default": "0" },
    { "fieldname": "column_break_2", "fieldtype": "Column Break" },
    { "fieldname": "storage_used_mb", "fieldtype": "Float", "label": "Storage Used (MB)", "default": "0" },

    { "fieldname": "section_notes", "fieldtype": "Section Break", "label": "Notes" },
    { "fieldname": "notes", "fieldtype": "Small Text", "label": "Notes" }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1 }
  ]
}
