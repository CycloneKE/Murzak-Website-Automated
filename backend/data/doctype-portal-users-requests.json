{
  "doctype": "DocType",
  "name": "Portal Users Requests",
  "module": "Custom",
  "custom": 1,
  "naming_rule": "Expression (old style)",
  "autoname": "hash",
  "title_field": "subject",
  "track_changes": 1,
  "sort_field": "modified",
  "sort_order": "DESC",
  "fields": [
    { "fieldname": "portal_user", "fieldtype": "Link", "label": "Portal User", "options": "Web Account", "in_standard_filter": 1 },
    { "fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email", "in_list_view": 1, "in_standard_filter": 1, "reqd": 1 },
    { "fieldname": "full_name", "fieldtype": "Data", "label": "Full Name", "in_list_view": 1 },
    { "fieldname": "company_name", "fieldtype": "Data", "label": "Company Name", "in_list_view": 1 },
    { "fieldname": "column_break_1", "fieldtype": "Column Break" },
    { "fieldname": "subject", "fieldtype": "Data", "label": "Subject", "default": "Technical Sync Request" },
    { "fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "New\nWaiting on Admin\nWaiting on User\nResolved", "default": "New", "in_list_view": 1, "in_standard_filter": 1 },
    { "fieldname": "source", "fieldtype": "Data", "label": "Source", "default": "Portal" },
    { "fieldname": "page_url", "fieldtype": "Small Text", "label": "Page URL", "description": "Where in the portal the customer raised this." },

    { "fieldname": "section_read_state", "fieldtype": "Section Break", "label": "Read State" },
    { "fieldname": "last_message_at", "fieldtype": "Datetime", "label": "Last Message At", "in_list_view": 1, "description": "Server-stamped on every message from either side; drives inbox ordering and both unread badges." },
    { "fieldname": "user_last_read_at", "fieldtype": "Datetime", "label": "User Last Read At", "description": "Stamped when the customer opens the thread. Compared against last_message_at for the customer's unread badge." },
    { "fieldname": "column_break_2", "fieldtype": "Column Break" },
    { "fieldname": "admin_last_read_at", "fieldtype": "Datetime", "label": "Admin Last Read At", "description": "Stamped when staff open the thread in the admin inbox. Compared against last_message_at for the staff unread badge." },

    { "fieldname": "section_messages", "fieldtype": "Section Break", "label": "Conversation" },
    { "fieldname": "messages", "fieldtype": "Table", "label": "Messages", "options": "Portal Users Request Messages" }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1 }
  ]
}
